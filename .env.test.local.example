# Set a dedicated, non-production database URL when exercising saved-game features.
# Anonymous route smoke tests do not perform database queries.
DATABASE_URL=postgresql://test:test@localhost/ballplus_test?sslmode=require

# Optional URL of an already-running test instance.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Optional Playwright storage state created for a dedicated Hexclave test user.
# PLAYWRIGHT_STORAGE_STATE=playwright/.auth/test-user.json
