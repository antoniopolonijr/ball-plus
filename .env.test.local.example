# Hexclave TEST project (Next.js public identifier + server-only key).
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=

# Dedicated Neon TEST database.
# Pooled connection used by application queries.
DATABASE_URL=

# Direct/unpooled connection used by Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Dedicated, non-production Hexclave users for authenticated E2E coverage.
# Create both users in the Hexclave TEST project with email/password sign-in enabled.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_SECONDARY_USER_EMAIL=
TEST_SECONDARY_USER_PASSWORD=

# Optional Vercel Blob TEST store token.
# Create a separate private Blob store for E2E uploads; never use the production token.
BLOB_READ_WRITE_TOKEN=

# Optional URL of an already-running test instance.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Generated by Playwright auth.setup.ts; keep under the ignored playwright/.auth directory.
# PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json
