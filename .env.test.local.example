# Hexclave cloud TEST project.
# Next.js client-side project identifier (public, safe to expose).
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=

# Hexclave server-side secret (never expose to the browser).
HEXCLAVE_SECRET_SERVER_KEY=

# Dedicated Neon TEST database.
# Runtime application queries use the pooled connection.
DATABASE_URL=

# Drizzle migrations use the direct, unpooled connection.
DATABASE_URL_UNPOOLED=

# Optional URL of an already-running test instance.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Optional path to a Playwright storage-state JSON for a dedicated test user.
# PLAYWRIGHT_STORAGE_STATE=playwright/.auth/test-user.json
